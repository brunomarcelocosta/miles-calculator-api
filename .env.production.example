PORT=3000

DATABASE_URL="mysql://travion:SENHA@host:3306/travion?sslaccept=strict&connection_limit=10&pool_timeout=20"

JWT_SECRET=<gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))">

