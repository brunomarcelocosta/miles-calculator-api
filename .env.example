# Copie para .env e preencha. O .env nunca vai para o Git.
NODE_ENV=development
PORT=3000

# A senha precisa ser percent-encoded na URL: @ -> %40, ! -> %21, # -> %23
# sslaccept=strict exige certificado valido. Se o servidor usar certificado
# autoassinado, o preflight (npm run db:check) indica trocar para
# sslaccept=accept_invalid_certs.
DATABASE_URL="mysql://user:password@host:3306/schema?sslaccept=strict&connection_limit=5&pool_timeout=20"

# Segredo do JWT de sessao do portal admin (32+ bytes aleatorios)
JWT_SECRET=

# Primeiro admin criado pelo comando de seed
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Origem permitida no CORS (a landing)
CORS_ORIGIN=http://localhost:5173

# Sal usado para gerar o hash do IP do lead (nunca guardamos IP em claro)
IP_HASH_SALT=
